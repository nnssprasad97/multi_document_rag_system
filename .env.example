# Server Configuration
PORT=3000
NODE_ENV=development

# Embedding and LLM Provider
# Set your OpenAI API key here. If omitted, the system seamlessly operates
# in offline/deterministic mock mode for unit tests and local demonstrations.
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector Database Configuration
# Supported providers: 'local' (embedded persistent vector store), 'chroma', 'qdrant', 'pinecone'
VECTOR_DB_PROVIDER=local
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=
VECTOR_DB_COLLECTION=rag_documents
VECTOR_SIMILARITY_THRESHOLD=0.70
TOP_K=5

# Relational Database Configuration
DATABASE_URL=sqlite:///./data/rag_history.db

# Document Ingestion Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
